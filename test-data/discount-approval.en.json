    },
    {
      "id": "discount-approval",
      "type": "decisionTableNode",
      "name": "Discount approval",
      "position": {
        "x": 400,
        "y": 200
      },
      "content": {
        "hitPolicy": "first",
        "passThrough": true,
        "inputs": [
          {
            "id": "discount",
            "name": "Discount percentage",
            "type": "expression",
            "field": "discount"
          }
        ],
        "outputs": [
          {
            "id": "approval",
            "name": "Approval result",
            "type": "expression",
            "field": "approval"
          }
        ],
        "rules": [
          {
            "_id": "automatic",
            "discount": "<= 5",
            "approval": "\"Automatically approved\""
          },
          {
            "_id": "sales-manager",
            "discount": "<= 10",
            "approval": "\"Sales manager approval\""
          },
          {
            "_id": "general-manager",
            "discount": "> 10",
            "approval": "\"General manager approval\""
          }
        ]
      }
    },
    {
      "id": "response",
      "type": "outputNode",
      "name": "Response",
      "position": {
        "x": 700,
        "y": 200
      }
    }
  ],
  "edges": [
    {
      "id": "request-to-rules",
      "sourceId": "request",
      "targetId": "discount-approval",
      "type": "edge"
    },
    {
      "id": "rules-to-response",
      "sourceId": "discount-approval",
      "targetId": "response",
      "type": "edge"
    }
  ],
