            "code": "\"PII_REDACT\"",
            "reason": "\"外发客户数据需先脱敏\"",
            "reviewer": "\"\""
          },
          {
            "_id": "PII_REVIEW",
            "condition": "facts.classification == \"customer\" and facts.external",
            "severity": "3",
            "code": "\"PII_REVIEW\"",
            "reason": "\"客户数据无法完整自动脱敏，需安全复核\"",
            "reviewer": "\"security\""
          },
          {
            "_id": "INTERNAL_EGRESS",
