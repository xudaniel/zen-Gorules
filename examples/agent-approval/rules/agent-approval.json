          {
            "_id": "DELETE_OWNER",
            "condition": "request.action == \"delete_records\"",
            "severity": "3",
            "code": "\"DELETE_OWNER\"",
            "reason": "\"删除操作需要业务负责人确认\"",
            "reviewer": "\"owner\""
