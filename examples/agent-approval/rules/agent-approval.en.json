{
  "contentType": "application/vnd.gorules.decision",
  "nodes": [
    {
      "id": "request",
      "type": "inputNode",
      "name": "Action request",
      "position": {
        "x": 0,
        "y": 200
      }
    },
    {
      "id": "identity",
      "type": "decisionTableNode",
      "name": "Identity & permissions",
      "position": {
        "x": 300,
        "y": 200
      },
      "content": {
        "hitPolicy": "first",
        "passThrough": true,
        "inputs": [
          {
            "id": "condition",
            "name": "Condition",
            "type": "expression",
            "field": ""
          }
        ],
        "outputs": [
          {
            "id": "severity",
            "name": "severity",
            "type": "expression",
            "field": "checks.identity.severity"
          },
          {
            "id": "code",
            "name": "code",
            "type": "expression",
            "field": "checks.identity.code"
          },
          {
            "id": "reason",
            "name": "reason",
            "type": "expression",
            "field": "checks.identity.reason"
          },
          {
            "id": "reviewer",
            "name": "reviewer",
            "type": "expression",
            "field": "checks.identity.reviewer"
          }
        ],
        "rules": [
          {
            "_id": "AGENT_DISABLED",
            "condition": "facts.agent_active == false",
            "severity": "4",
            "code": "\"AGENT_DISABLED\"",
            "reason": "\"The agent is disabled\"",
            "reviewer": "\"\""
          },
          {
            "_id": "SCOPE_DENIED",
            "condition": "facts.scope_allowed == false",
            "severity": "4",
            "code": "\"SCOPE_DENIED\"",
            "reason": "\"The agent does not have permission to use this tool\"",
            "reviewer": "\"\""
          },
          {
            "_id": "DELETE_OWNER",
            "condition": "request.action == \"delete_records\"",
            "severity": "3",
            "code": "\"DELETE_OWNER\"",
            "reason": "\"Deletion requires business owner approval\"",
            "reviewer": "\"owner\""
          },
          {
            "_id": "IDENTITY_OK",
            "condition": "true",
            "severity": "1",
            "code": "\"IDENTITY_OK\"",
            "reason": "\"The agent is active and the action is within its permissions\"",
            "reviewer": "\"\""
          }
        ]
      }
    },
    {
      "id": "data",
      "type": "decisionTableNode",
      "name": "Data classification",
      "position": {
        "x": 600,
        "y": 200
      },
      "content": {
        "hitPolicy": "first",
        "passThrough": true,
        "inputs": [
          {
            "id": "condition",
            "name": "Condition",
            "type": "expression",
            "field": ""
          }
        ],
        "outputs": [
          {
            "id": "severity",
            "name": "severity",
            "type": "expression",
            "field": "checks.data.severity"
          },
          {
            "id": "code",
            "name": "code",
            "type": "expression",
            "field": "checks.data.code"
          },
          {
            "id": "reason",
            "name": "reason",
            "type": "expression",
            "field": "checks.data.reason"
          },
          {
            "id": "reviewer",
            "name": "reviewer",
            "type": "expression",
            "field": "checks.data.reviewer"
          }
        ],
        "rules": [
          {
            "_id": "SECRET_EGRESS",
            "condition": "facts.classification == \"secret\" and facts.external",
            "severity": "4",
            "code": "\"SECRET_EGRESS\"",
            "reason": "\"Secrets and credentials must not be sent externally\"",
            "reviewer": "\"\""
          },
          {
            "_id": "SECRET_INTERNAL",
            "condition": "facts.classification == \"secret\"",
            "severity": "3",
            "code": "\"SECRET_INTERNAL\"",
            "reason": "\"Internal secret access requires security approval\"",
            "reviewer": "\"security\""
          },
          {
            "_id": "PII_REDACT",
            "condition": "facts.classification == \"customer\" and facts.external and facts.redactable",
            "severity": "2",
            "code": "\"PII_REDACT\"",
            "reason": "\"Redact customer contact details before sending externally\"",
            "reviewer": "\"\""
          },
          {
            "_id": "PII_REVIEW",
            "condition": "facts.classification == \"customer\" and facts.external",
            "severity": "3",
            "code": "\"PII_REVIEW\"",
            "reason": "\"Customer data cannot be fully redacted automatically; security review required\"",
            "reviewer": "\"security\""
          },
          {
            "_id": "INTERNAL_EGRESS",
            "condition": "facts.classification == \"internal\" and facts.external",
            "severity": "3",
            "code": "\"INTERNAL_EGRESS\"",
            "reason": "\"Sending internal data externally requires business owner approval\"",
            "reviewer": "\"owner\""
          },
          {
            "_id": "DATA_OK",
            "condition": "true",
            "severity": "1",
            "code": "\"DATA_OK\"",
            "reason": "\"The data classification permits this action\"",
            "reviewer": "\"\""
          }
        ]
      }
    },
    {
      "id": "destination",
      "type": "decisionTableNode",
      "name": "Destination trust",
      "position": {
        "x": 900,
        "y": 200
      },
      "content": {
        "hitPolicy": "first",
        "passThrough": true,
        "inputs": [
          {
            "id": "condition",
            "name": "Condition",
            "type": "expression",
            "field": ""
          }
        ],
        "outputs": [
          {
            "id": "severity",
            "name": "severity",
            "type": "expression",
            "field": "checks.destination.severity"
          },
          {
            "id": "code",
            "name": "code",
            "type": "expression",
            "field": "checks.destination.code"
          },
          {
            "id": "reason",
            "name": "reason",
            "type": "expression",
            "field": "checks.destination.reason"
          },
          {
            "id": "reviewer",
            "name": "reviewer",
            "type": "expression",
            "field": "checks.destination.reviewer"
          }
        ],
        "rules": [
          {
            "_id": "TARGET_BLOCKED",
            "condition": "facts.destination == \"blocked\"",
            "severity": "4",
            "code": "\"TARGET_BLOCKED\"",
            "reason": "\"The destination is on the demo blocklist\"",
            "reviewer": "\"\""
          },
          {
            "_id": "UNKNOWN_API",
            "condition": "facts.destination == \"external\" and request.action == \"http_request\"",
            "severity": "3",
            "code": "\"UNKNOWN_API\"",
            "reason": "\"An unknown external API requires security review\"",
            "reviewer": "\"security\""
          },
          {
            "_id": "NEW_RECIPIENT",
            "condition": "facts.destination == \"external\" and request.action == \"send_email\"",
            "severity": "3",
            "code": "\"NEW_RECIPIENT\"",
            "reason": "\"A new external recipient requires business owner approval\"",
            "reviewer": "\"owner\""
          },
          {
            "_id": "TRUSTED_TARGET",
            "condition": "facts.destination == \"trusted\"",
            "severity": "1",
            "code": "\"TRUSTED_TARGET\"",
            "reason": "\"The destination is a listed demo partner\"",
            "reviewer": "\"\""
          },
          {
            "_id": "TARGET_OK",
            "condition": "true",
            "severity": "1",
            "code": "\"TARGET_OK\"",
            "reason": "\"Destination check passed\"",
            "reviewer": "\"\""
          }
        ]
      }
    },
    {
      "id": "environment",
      "type": "decisionTableNode",
      "name": "Environment",
      "position": {
        "x": 1200,
        "y": 200
      },
      "content": {
        "hitPolicy": "first",
        "passThrough": true,
        "inputs": [
          {
            "id": "condition",
            "name": "Condition",
            "type": "expression",
            "field": ""
          }
        ],
        "outputs": [
          {
            "id": "severity",
            "name": "severity",
            "type": "expression",
            "field": "checks.environment.severity"
          },
          {
            "id": "code",
            "name": "code",
            "type": "expression",
            "field": "checks.environment.code"
          },
          {
            "id": "reason",
            "name": "reason",
            "type": "expression",
            "field": "checks.environment.reason"
          },
          {
            "id": "reviewer",
            "name": "reviewer",
            "type": "expression",
            "field": "checks.environment.reviewer"
          }
        ],
        "rules": [
          {
            "_id": "PROD_DELETE",
            "condition": "request.environment == \"production\" and request.action == \"delete_records\"",
            "severity": "4",
            "code": "\"PROD_DELETE\"",
            "reason": "\"Demo policy forbids deleting production records\"",
            "reviewer": "\"\""
          },
          {
            "_id": "PROD_WRITE",
            "condition": "request.environment == \"production\" and request.action == \"update_record\"",
            "severity": "3",
            "code": "\"PROD_WRITE\"",
            "reason": "\"Production data changes require business owner approval\"",
            "reviewer": "\"owner\""
          },
          {
            "_id": "PROD_API",
            "condition": "request.environment == \"production\" and request.action == \"http_request\"",
            "severity": "3",
            "code": "\"PROD_API\"",
            "reason": "\"Production API actions require security approval\"",
            "reviewer": "\"security\""
          },
          {
            "_id": "SANDBOX",
            "condition": "request.environment == \"sandbox\"",
            "severity": "1",
            "code": "\"SANDBOX\"",
            "reason": "\"Sandbox environment; data and permission limits still apply\"",
            "reviewer": "\"\""
          },
          {
            "_id": "ENV_OK",
            "condition": "true",
            "severity": "1",
            "code": "\"ENV_OK\"",
            "reason": "\"Environment check passed\"",
            "reviewer": "\"\""
          }
        ]
      }
    },
    {
      "id": "refund_eligibility",
      "type": "decisionTableNode",
      "name": "Refund eligibility",
      "position": {
        "x": 1500,
        "y": 200
      },
      "content": {
        "hitPolicy": "first",
        "passThrough": true,
        "inputs": [
          {
            "id": "condition",
            "name": "Condition",
            "type": "expression",
            "field": ""
          }
        ],
        "outputs": [
          {
            "id": "severity",
            "name": "severity",
            "type": "expression",
            "field": "checks.refund_eligibility.severity"
          },
          {
            "id": "code",
            "name": "code",
            "type": "expression",
            "field": "checks.refund_eligibility.code"
          },
          {
            "id": "reason",
            "name": "reason",
            "type": "expression",
            "field": "checks.refund_eligibility.reason"
          },
          {
            "id": "reviewer",
            "name": "reviewer",
            "type": "expression",
            "field": "checks.refund_eligibility.reviewer"
          }
        ],
        "rules": [
          {
            "_id": "NOT_REFUND",
            "condition": "request.action != \"issue_refund\"",
            "severity": "1",
            "code": "\"NOT_REFUND\"",
            "reason": "\"This action is not a refund\"",
            "reviewer": "\"\""
          },
          {
            "_id": "ORDER_NOT_FOUND",
            "condition": "facts.order_exists == false",
            "severity": "4",
            "code": "\"ORDER_NOT_FOUND\"",
            "reason": "\"Order not found in the payment sandbox\"",
            "reviewer": "\"\""
          },
          {
            "_id": "REFUND_AMOUNT",
            "condition": "request.cost <= 0",
            "severity": "4",
            "code": "\"REFUND_AMOUNT\"",
            "reason": "\"Refund amount must be greater than zero\"",
            "reviewer": "\"\""
          },
          {
            "_id": "REFUND_BALANCE",
            "condition": "request.cost > facts.refundable_amount",
            "severity": "4",
            "code": "\"REFUND_BALANCE\"",
            "reason": "\"Refund amount exceeds the order’s refundable balance\"",
            "reviewer": "\"\""
          },
          {
            "_id": "REFUND_WINDOW",
            "condition": "facts.order_age_days > 60",
            "severity": "4",
            "code": "\"REFUND_WINDOW\"",
            "reason": "\"Order is beyond the 60-day refund window\"",
            "reviewer": "\"\""
          },
          {
            "_id": "REFUND_CAP",
            "condition": "request.cost > 500",
            "severity": "4",
            "code": "\"REFUND_CAP\"",
            "reason": "\"Refund exceeds the USD 500 per-action cap\"",
            "reviewer": "\"\""
          },
          {
            "_id": "REFUND_ELIGIBLE",
            "condition": "true",
            "severity": "1",
            "code": "\"REFUND_ELIGIBLE\"",
            "reason": "\"Order and refund amount meet the base eligibility rules\"",
            "reviewer": "\"\""
          }
        ]
      }
    },
    {
      "id": "refund_operations",
      "type": "decisionTableNode",
      "name": "Refund operations",
      "position": {
        "x": 1800,
        "y": 200
      },
      "content": {
        "hitPolicy": "first",
        "passThrough": true,
        "inputs": [
          {
            "id": "condition",
