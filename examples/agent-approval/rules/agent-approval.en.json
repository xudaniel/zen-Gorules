          }
        ],
        "rules": [
          {
            "_id": "NOT_REFUND",
            "condition": "request.action != \"issue_refund\"",
            "severity": "1",
            "code": "\"NOT_REFUND\"",
            "reason": "\"This action is not a refund\"",
            "reviewer": "\"\""
          },
          {
            "_id": "REFUND_RISK",
            "condition": "facts.refund_risk_flag",
            "severity": "3",
            "code": "\"REFUND_RISK\"",
            "reason": "\"The sandbox order has a risk flag and requires security review\"",
            "reviewer": "\"security\""
          },
          {
            "_id": "REFUND_HISTORY",
            "condition": "facts.prior_refunds >= 2",
            "severity": "3",
            "code": "\"REFUND_HISTORY\"",
            "reason": "\"Frequent prior refunds require security review\"",
            "reviewer": "\"security\""
          },
          {
            "_id": "REFUND_RISK_OK",
            "condition": "true",
            "severity": "1",
            "code": "\"REFUND_RISK_OK\"",
            "reason": "\"Refund history and risk flags are within policy\"",
            "reviewer": "\"\""
          }
        ]
      }
    },
