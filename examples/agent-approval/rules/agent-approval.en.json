          },
          {
            "_id": "RATE_LIMIT",
            "condition": "facts.executions_hour >= 20",
            "severity": "4",
            "code": "\"RATE_LIMIT\"",
            "reason": "\"20 executions in the last hour; demo rate limit reached\"",
            "reviewer": "\"\""
          },
          {
            "_id": "BULK_REVIEW",
            "condition": "request.records > facts.review_record_limit",
