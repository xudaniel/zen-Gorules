    {
      "id": "budget",
      "type": "decisionTableNode",
      "name": "Cost & budget",
      "position": {
        "x": 3000,
        "y": 200
      },
      "content": {
        "hitPolicy": "first",
        "passThrough": true,
        "inputs": [
          {
            "id": "condition",
            "name": "Condition",
            "type": "expression",
            "field": ""
          }
        ],
        "outputs": [
          {
            "id": "severity",
            "name": "severity",
            "type": "expression",
            "field": "checks.budget.severity"
          },
          {
            "id": "code",
            "name": "code",
            "type": "expression",
            "field": "checks.budget.code"
          },
          {
            "id": "reason",
            "name": "reason",
            "type": "expression",
            "field": "checks.budget.reason"
          },
          {
            "id": "reviewer",
            "name": "reviewer",
            "type": "expression",
            "field": "checks.budget.reviewer"
          }
        ],
        "rules": [
          {
            "_id": "SINGLE_BUDGET",
            "condition": "request.action != \"issue_refund\" and request.cost > 500",
            "severity": "4",
            "code": "\"SINGLE_BUDGET\"",
            "reason": "\"Estimated action cost exceeds 500 demo credits\"",
            "reviewer": "\"\""
          },
          {
            "_id": "TOTAL_BUDGET",
            "condition": "request.action != \"issue_refund\" and facts.cost_hour + request.cost > 1000",
            "severity": "4",
            "code": "\"TOTAL_BUDGET\"",
            "reason": "\"Total cost in the last hour would exceed 1,000 demo credits\"",
            "reviewer": "\"\""
          },
          {
            "_id": "FINANCE_REVIEW",
            "condition": "request.action != \"issue_refund\" and request.cost > 100",
            "severity": "3",
            "code": "\"FINANCE_REVIEW\"",
            "reason": "\"Estimated cost exceeds 100 credits; finance approval required\"",
            "reviewer": "\"finance\""
          },
          {
            "_id": "BUDGET_OK",
            "condition": "request.action != \"issue_refund\" and request.cost > 0",
            "severity": "1",
            "code": "\"BUDGET_OK\"",
            "reason": "\"Estimated cost is within budget\"",
            "reviewer": "\"\""
