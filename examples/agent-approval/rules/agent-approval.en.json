          },
          {
            "id": "reviewer",
            "name": "reviewer",
            "type": "expression",
            "field": "checks.refund_operations.reviewer"
          }
        ],
        "rules": [
          {
            "_id": "NOT_REFUND",
            "condition": "request.action != \"issue_refund\"",
            "severity": "1",
            "code": "\"NOT_REFUND\"",
            "reason": "\"This action is not a refund\"",
            "reviewer": "\"\""
          },
          {
            "_id": "REFUND_OWNER",
            "condition": "request.cost > 50",
            "severity": "3",
            "code": "\"REFUND_OWNER\"",
            "reason": "\"Refunds above USD 50 require support lead approval\"",
            "reviewer": "\"support\""
          },
          {
            "_id": "REFUND_AGE_REVIEW",
            "condition": "facts.order_age_days > 30",
            "severity": "3",
            "code": "\"REFUND_AGE_REVIEW\"",
            "reason": "\"Orders older than 30 days require support lead review\"",
            "reviewer": "\"support\""
          },
          {
            "_id": "REFUND_OPS_OK",
            "condition": "true",
            "severity": "1",
            "code": "\"REFUND_OPS_OK\"",
            "reason": "\"Refund is within the automatic support limit\"",
            "reviewer": "\"\""
          }
        ]
      }
    },
